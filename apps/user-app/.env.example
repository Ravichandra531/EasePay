DATABASE_URL="postgresql://postgres:postgres@localhost:5432/easepay"
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="replace-with-a-random-secret"
# Explicitly enables demo bank approvals. Disable for real payment integrations.
BANK_SANDBOX_ENABLED=true

# Public app address encoded into merchant payment QRs.
APP_URL="http://localhost:3001"
# sandbox | razorpay
PAYMENT_PROVIDER="sandbox"
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this stable; existing encrypted bank accounts depend on it.
BANK_ACCOUNT_ENCRYPTION_KEY=""

# Razorpay Checkout keys (use rzp_test_ keys during development).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# RazorpayX keys and the funding account identifier from your dashboard.
RAZORPAYX_KEY_ID=""
RAZORPAYX_KEY_SECRET=""
RAZORPAYX_ACCOUNT_NUMBER=""
# Use this same webhook secret when configuring the payment/payout endpoints.
RAZORPAY_WEBHOOK_SECRET=""
# Live mode also requires BANK_SANDBOX_ENABLED=false and approved live accounts.
LIVE_PAYMENTS_ENABLED=false

# Phone verification. See AUTH.md for local development and Twilio setup.
# Generate a separate random secret of at least 32 bytes; keep it private.
OTP_SECRET=""
OTP_PROVIDER="twilio"
ALLOW_DEV_OTP=false
TWILIO_VERIFY_SERVICE_SID=""
TWILIO_API_KEY_SID=""
TWILIO_API_KEY_SECRET=""
# Alternative authentication when API keys are not used:
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
